{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:trace": "LOG_LEVEL=TRACE tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:coverage": "vitest run --coverage",
    "docs:build": "typedoc",
    "docs:dev": "concurrently --kill-others --names typedoc,serve \"typedoc --watch\" \"serve docs --listen 4001\""
  },
  "dependencies": {
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/clob-client": "^5.2.4",
    "@polymarket/order-utils": "^3.0.1",
    "@repo/backend": "workspace:*",
    "convex": "^1.32.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "express": "^5.1.0",
    "nats": "^2.29.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "serve": "^14.2.5",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.17",
    "typescript": "5.9.2",
    "vitest": "^4.0.18"
  }
}
